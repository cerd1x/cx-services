{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cxs",
  "main": "./build/worker.js",
  "no_bundle": true,
  // >= 2026-08-04: Workers mengaktifkan nodejs_compat + nodejs_compat_v2
  // secara default, jadi tidak perlu `compatibility_flags` lagi.
  "compatibility_date": "2026-08-04",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "CX_DB",
      "database_name": "cxapp-db",
      "database_id": "227f06fb-c27e-4f9c-bf8a-d2aae1fbb822",
      "migrations_dir": "drizzle",
      // drizzle-kit menaruh SQL di `drizzle/<timestamp>_<name>/migration.sql`,
      // sedangkan wrangler mencari `drizzle/*.sql` (datar).
      "migrations_pattern": "drizzle/*/migration.sql",
    },
  ],
  // r2_buckets removed — BETA_REPORT_R2 binding disabled; beta-report falls back to Memory backend
  "vars": {
    "NODE_ENV": "production",
    "GQL_PATH": "/graphql",
    "LOGGER_DIR": ".logger-file",
    // GraphiQL IDE + introspection aktif di production (schema jadi
    // terbaca publik; otorisasi per-field tetap lewat @authorized).
    // Set "false" untuk mematikan lagi tanpa mengubah kode.
    "GQL_GRAPHIQL": "true",
  },
}
