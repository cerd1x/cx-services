# --- Runtime ---
NODE_ENV=development
# Origin web yang diizinkan CORS (pisahkan dengan koma)
ORIGIN=http://localhost:5173
# Path GraphQL yang dilayani worker
GQL_PATH=/graphql
# Kunci tanda tangan JWT + HMAC challenge WebAuthn (wajib, >= 32 karakter)
SECRET_KEY=your-secret-key-here
LOGGER_DIR=.logger-file

# --- Database (hanya untuk drizzle-kit lokal / libsql) ---
DATABASE_URL=local.db
DATABASE_PASSWORD=

# --- Drizzle Kit remote (d1-http, dipakai saat NODE_ENV=production) ---
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_DATABASE_ID=your-cloudflare-database-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# --- Beta report (R2 + Cloudflare Email Service) ---
BETA_REPORT_FROM_EMAIL=noreply@cx-services.workers.dev
BETA_REPORT_FROM_NAME=Cerdix Beta
BETA_REPORT_TO_EMAILS=beta@example.com
BETA_REPORT_ADMIN_TOKEN=your-admin-token
BETA_REPORT_R2_BUCKET=cxapp-beta-reports

# --- Gemini OAuth (dipakai klien desktop cx-dompetqu) ---
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GEMINI_OAUTH_REDIRECT_URI=http://localhost:8787/api/gemini/oauth/callback
GEMINI_OAUTH_TOKEN_STORE=d1
GEMINI_OAUTH_ENCRYPTION_KEY=your-32-byte-base64-encryption-key
