{
  "name": "cx-services",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "app.ts",
  "scripts": {
    "dev": "bun run build && wrangler dev",
    "build": "bun run scripts/build.ts",
    "deploy": "NODE_ENV=production bun run build && wrangler deploy",
    "gql:gen": "graphql-codegen --config codegen.ts",
    "gql:watch": "graphql-codegen --config codegen.ts --watch",
    "check": "bun check --no-script -p tsconfig.json",
    "lint": "bun lint",
    "fmt": "bun fmt",
    "lint:fix": "bun lint --fix",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "bun test --parallel=4 --preload ./tests/setup.ts tests",
    "test:unit": "bun test --parallel=4 --preload ./tests/setup.ts tests",
    "test:e2e": "bun test --parallel=4 --preload ./tests/setup.ts tests/e2e",
    "e2e:auth": "bun run scripts/test_e2e_runner.ts auth",
    "e2e:asset": "bun run scripts/test_e2e_runner.ts asset",
    "e2e:contact": "bun run scripts/test_e2e_runner.ts contact",
    "e2e:order": "bun run scripts/test_e2e_runner.ts order",
    "e2e:payment": "bun run scripts/test_e2e_runner.ts payment",
    "e2e:product": "bun run scripts/test_e2e_runner.ts product",
    "e2e:setting": "bun run scripts/test_e2e_runner.ts setting",
    "e2e:statistic": "bun run scripts/test_e2e_runner.ts statistic",
    "e2e:transaction": "bun run scripts/test_e2e_runner.ts transaction",
    "e2e:user": "bun run scripts/test_e2e_runner.ts user"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@elysia/cors": "rc",
    "@elysia/node": "2.0.0-beta.3",
    "@graphql-tools/schema": "^10.0.38",
    "@graphql-tools/utils": "^11.2.2",
    "@noble/hashes": "^2.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@types/vcf": "^2.0.7",
    "cloudflare": "^7.3.0",
    "dinero.js": "^2.0.2",
    "elysia": "rc",
    "elysia-rate-limit": "4.6.3",
    "graphql": "^17.0.2",
    "graphql-scalars": "^1.25.0",
    "graphql-yoga": "^5.21.2",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "sqids": "^0.3.0",
    "vcf": "^2.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-resolvers": "^6.1.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^26.6.2",
    "bun-types": "^1.4.0",
    "drizzle-kit": "1.0.0-rc.4-ca0f029",
    "drizzle-orm": "1.0.0-rc.4-5d5b77c",
    "wrangler": "^4.149.0"
  },
  "packageManager": "bun@1.4.0"
}
